PORT=5000

# MongoDB Connection String:
# For Local MongoDB: mongodb://127.0.0.1:27017/unity_print
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/unity_print?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/unity_print

# JWT Secret for Admin Auth
JWT_SECRET=unity_print_pack_jwt_secret_super_key_2026

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Default Admin Credentials
DEFAULT_ADMIN_EMAIL=admin@unityprint.com
DEFAULT_ADMIN_PASSWORD=admin123

# ImageKit Cloud Storage Configuration
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
